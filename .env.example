# Puertos externos del Host (modificar si el puerto 8000 o 5173 ya están ocupados en el servidor)
BACKEND_PORT=8001
FRONTEND_PORT=5173

# Configuración de Ollama (Host)

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:4b

# Proveedor de LLM: ollama (local) | gemini (Google AI Studio) | openai (OpenAI GPT-4o / GPT-4o-mini)
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Persistencia
DATABASE_URL=sqlite:///./data/rh.sqlite
STORAGE_PATH=/app/storage/candidates

# Límites
MAX_CV_SIZE_MB=10

# Despacho de mensajes hacia wbhookOmnicanal
WEBHOOK_SEND_URL=http://host.docker.internal:5000/messages/send
WEBHOOK_API_KEY=your_secret_api_key_here

# Frontend API URL (Opcional en desarrollo, recomendado si asignas dominio/subdominio al backend)
# Ejemplo: VITE_API_URL=https://api-rrhh.grupojpm.mx
VITE_API_URL=

# Puerto HMR de Vite para WebSocket seguro tras reverse proxy HTTPS (por defecto 443 en produccion)
VITE_HMR_CLIENT_PORT=443

# ==============================================================================
# SEGURIDAD Y HARDENING DE DATOS SENSIBLES (PII, CVs E IDENTIFICACIONES)
# ==============================================================================
# Clave maestra para firmado criptográfico HMAC de URLs temporales y cifrado simétrico
SECURITY_SECRET_KEY=cambiar_por_clave_secreta_segura_de_al_menos_32_caracteres_aleatorios!

# Clave administrativa para proteger endpoints de gestión y reclutamiento (X-API-Key / Bearer)
ADMIN_API_KEY=tu_clave_api_para_reclutadores_admin_2026

# Activa la exigencia obligatoria de autenticación en endpoints de candidatos (true/false)
REQUIRE_AUTH=false

# Exige obligatoriamente tokens firmados (HMAC) con expiración corta para descargar PDFs o IDs (true/false)
ENFORCE_SIGNED_URLS=false

# Cifrado simétrico en reposo (AES-256 / Fernet) para archivos en disco y campos PII de BD (true/false)
ENABLE_AT_REST_ENCRYPTION=true

# Política de retención temporal: horas de vida de la foto de identificación antes de auto-purga
ID_DOCUMENT_RETENTION_HOURS=24

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

